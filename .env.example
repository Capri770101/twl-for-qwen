# ============================================================
# 跳舞兰 H5 电商系统 · 环境变量模板
#
# 【怎么用】
#   1. 复制这个文件为 .env
#      cp .env.example .env
#   2. 按下面的说明填值
#   3. 不要提交 .env 到 git（里面有密码）
#
# 【改完配置要重启服务才生效】
#
# 【优先级】
#   环境变量 > .env 文件 > 代码里的默认值
# ============================================================

# ────────────────────────────────────────────────────────────
# 【应用】
# ────────────────────────────────────────────────────────────
APP_NAME=跳舞兰 H5 电商系统
APP_VERSION=1.0.0

# 环境：development / testing / production
# 生产环境必须是 production，否则安全校验不生效
APP_ENV=development

# 调试模式：生产环境必须 False
DEBUG=true

# 演示模式：true = 交付演示（显示演示标识、配送信息待配置）
#           false = 正常运营（接入真实数据后改）
DEMO_MODE=true

HOST=127.0.0.1
PORT=8000
API_V1_PREFIX=/api/v1


# ────────────────────────────────────────────────────────────
# 【数据库】
# ────────────────────────────────────────────────────────────
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=tiaowulan
POSTGRES_PASSWORD=twl_dev_2026
POSTGRES_DB=tiaowulan

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_ECHO=false


# ────────────────────────────────────────────────────────────
# 【安全】—— 生产环境必改
# ────────────────────────────────────────────────────────────

# 密钥：至少 32 位随机字符串
# 生成方法：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please-use-a-random-string

# Token 有效期（分钟）
TOKEN_EXPIRE_MINUTES=10080

# 是否启用 token 黑名单（退出登录立即失效）
TOKEN_BLACKLIST_ENABLED=true


# ────────────────────────────────────────────────────────────
# 【跨域】—— 生产环境必须填具体域名
# ────────────────────────────────────────────────────────────
# 开发：http://localhost:3000,http://127.0.0.1:3000
# 生产：https://h5.tiaowulan.com,https://www.tiaowulan.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 允许的 Host（生产填域名，多个用逗号分隔）
ALLOWED_HOSTS=*

# 是否启用安全响应头
SECURITY_HEADERS_ENABLED=true


# ────────────────────────────────────────────────────────────
# 【管理员】
# ────────────────────────────────────────────────────────────
# 【重要】上线前必须清空！
# 这个列表里的手机号，注册时自动成为管理员。
# 生产环境留空，管理员通过数据库手动设置：
#   UPDATE users SET is_admin = TRUE WHERE phone = '13800001234';
ADMIN_PHONES=


# ────────────────────────────────────────────────────────────
# 【限流】
# ────────────────────────────────────────────────────────────

# 发验证码：同一手机号多少秒内只能发 1 次
SMS_INTERVAL_SECONDS=60

# 发验证码：同一手机号每天最多几次
SMS_DAILY_LIMIT=10

# 发验证码：同一 IP 每小时最多几次
SMS_IP_HOURLY_LIMIT=20

# 登录：连续失败几次锁号
LOGIN_MAX_ATTEMPTS=5

# 登录：锁多久（分钟）
LOGIN_LOCK_MINUTES=15

# 下单：同一 IP 每小时最多几单
ORDER_IP_HOURLY_LIMIT=30


# ────────────────────────────────────────────────────────────
# 【缓存 / 验证码存储】
# ────────────────────────────────────────────────────────────
# development → memory（进程内存，重启丢失）
# production  → redis（必须，多进程共享）
CACHE_PROVIDER=memory

REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PASSWORD=


# ────────────────────────────────────────────────────────────
# 【短信服务商】
# ────────────────────────────────────────────────────────────
# development → mock（验证码直接返回给前端）
# production  → aliyun / tencent（必须）
SMS_PROVIDER=mock

# 阿里云短信
# 申请地址：https://dysms.console.aliyun.com/
# 需要先在控制台申请「签名」和「模板」并审核通过
ALIYUN_SMS_KEY_ID=
ALIYUN_SMS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# 腾讯云短信
# 申请地址：https://console.cloud.tencent.com/smsv2
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=


# ────────────────────────────────────────────────────────────
# 【文件存储】
# ────────────────────────────────────────────────────────────
# development → local（本地磁盘 backend/static/uploads/）
# production  → oss / cos（必须，否则多机部署图片 404）
STORAGE_PROVIDER=local

# 阿里云 OSS
# 申请地址：https://oss.console.aliyun.com/
# 需要创建 Bucket 并设置为「公共读」
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_URL=

# 上传大小上限（MB）
UPLOAD_MAX_SIZE_MB=5


# ────────────────────────────────────────────────────────────
# 【支付网关】
# ────────────────────────────────────────────────────────────
# development → mock（模拟收银台，点一下就到账）
# production  → wechat / alipay（必须，需要商户资质）
PAYMENT_PROVIDER=mock

# 微信支付
# 申请地址：https://pay.weixin.qq.com/
# 需要：营业执照 + 对公账户 + ICP 备案
WECHAT_PAY_MCH_ID=
WECHAT_PAY_APP_ID=
WECHAT_PAY_KEY=
WECHAT_PAY_CERT_PATH=
WECHAT_PAY_NOTIFY_URL=

# 支付宝
# 申请地址：https://open.alipay.com/
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=


# ────────────────────────────────────────────────────────────
# 【履约系统】
# ────────────────────────────────────────────────────────────
# development → mock（本地模拟状态流转）
# production  → real（接入真实配送系统）
FULFILLMENT_PROVIDER=mock

FULFILLMENT_API_URL=
FULFILLMENT_API_KEY=
FULFILLMENT_CALLBACK_SECRET=


# ────────────────────────────────────────────────────────────
# 【数据源】
# ────────────────────────────────────────────────────────────
# development → mock（本地 8 个商品）
# production  → real（同步真实商品库）
DATASOURCE_PROVIDER=mock

DATASOURCE_API_URL=
DATASOURCE_API_KEY=


# ────────────────────────────────────────────────────────────
# 【业务参数】
# ────────────────────────────────────────────────────────────

# 订单支付超时（分钟）
ORDER_EXPIRE_MINUTES=30

# 免运费门槛（分）
FREE_SHIPPING_THRESHOLD=19900

# 基础运费（分）
BASE_SHIPPING_FEE=1500


# ────────────────────────────────────────────────────────────
# 【日志】
# ────────────────────────────────────────────────────────────
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# json（生产，便于日志系统采集）/ console（开发，好看）
LOG_FORMAT=console
